NODE_ENV=
PORT=
JWT_SECRET=

# Swagger 設定
# SWAGGER_ENABLED：true=開啟 / false=關閉（不設則 dev 預設開、prod 預設關）
# 以下帳密若未設定，Swagger 直接放行不需登入；設定後才會啟用 Basic Auth 保護
SWAGGER_ENABLED=
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=

GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_BUCKET_NAME=
DATABASE_URL=
