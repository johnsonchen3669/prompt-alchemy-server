NODE_ENV=
PORT=
JWT_SECRET=

# Swagger 設定
# SWAGGER_ENABLED：true=開啟 / false=關閉（不設則 dev 預設開、prod 預設關）
# 開啟時需設定以下帳密（Basic Auth 保護 /docs、/scalar、/openapi.json）
SWAGGER_ENABLED=
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=

GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_BUCKET_NAME=
DATABASE_URL=
